---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/contact.css';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? '';
---

<BaseLayout title="聯絡 VIO｜唯創" lang="zh-Hant" headerLang="zh">
  <Fragment slot="head">
    <meta
      name="description"
      content="留下基本聯絡資訊與簡要需求，與 VIO 開始討論設備隔震、振動控制與耐震防護需求。"
    />
  </Fragment>

  <Fragment slot="scripts">
    <script src={`${basePath}/js/contact.js`} is:inline></script>
  </Fragment>

  <main class="contact-main">
    <section class="contact-layout" aria-labelledby="contact-title">
      <div class="contact-intro-panel">
        <div class="contact-intro-content">
          <div class="contact-symbol" aria-hidden="true">
            <svg viewBox="0 0 96 80" role="presentation">
              <path d="M8 8h66v43H35L19 66V51H8V8Z"></path>
              <path d="M66 28h22v34H76v10L64 62H47V51"></path>
            </svg>
          </div>

          <p class="contact-eyebrow en-text">CONTACT</p>
          <h1 id="contact-title" class="contact-title tc-text">與我們聯絡</h1>
          <p class="contact-lead tc-text">
            有專案需求、產品問題或合作想法，歡迎留下訊息。
          </p>

          <div class="contact-reassurance tc-text" aria-label="填寫說明">
            <p>不需要先知道產品型號。</p>
            <p>資料尚未完整，也可以先開始討論。</p>
          </div>
        </div>

        <div class="contact-panel-mark en-text" aria-hidden="true">VIO / CONTACT</div>
      </div>

      <div class="contact-form-panel">
        <div class="contact-form-wrap">
          <header class="contact-form-header">
            <p class="contact-form-kicker en-text">START A CONVERSATION</p>
            <h2 class="contact-form-title tc-text">簡單告訴我們，目前想了解什麼</h2>
            <p class="contact-form-copy tc-text">
              只需留下基本聯絡資訊與一點訊息；若需要其他資料，我們會再與您確認。
            </p>
          </header>

          <form
            id="contact-form"
            class="contact-form"
            method="post"
            data-endpoint={formEndpoint}
            novalidate
          >
            <div class="contact-form-row">
              <div class="contact-field">
                <label for="contact-name" class="tc-text">姓名 <span aria-hidden="true">*</span></label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                  aria-describedby="name-error"
                />
                <span id="name-error" class="field-error tc-text" data-error-for="contact-name"></span>
              </div>

              <div class="contact-field">
                <label for="contact-company" class="tc-text">公司／單位 <span class="optional">選填</span></label>
                <input
                  id="contact-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                />
              </div>
            </div>

            <div class="contact-field">
              <label for="contact-email" class="tc-text">Email <span aria-hidden="true">*</span></label>
              <input
                id="contact-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                required
                aria-describedby="email-error"
              />
              <span id="email-error" class="field-error tc-text" data-error-for="contact-email"></span>
            </div>

            <div class="contact-field">
              <label for="contact-message" class="tc-text">想詢問什麼？ <span aria-hidden="true">*</span></label>
              <textarea
                id="contact-message"
                name="message"
                rows="6"
                required
                aria-describedby="message-hint message-error"
                placeholder="簡單描述目前的需求或問題即可"
              ></textarea>
              <span id="message-hint" class="field-hint tc-text">不需要整理成正式規格。</span>
              <span id="message-error" class="field-error tc-text" data-error-for="contact-message"></span>
            </div>

            <div class="contact-honeypot" aria-hidden="true">
              <label for="contact-website">Website</label>
              <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <input id="contact-context" name="context" type="hidden" value="" />

            <div class="contact-submit-area">
              <button type="submit" class="contact-submit tc-text">
                <span data-submit-label>送出詢問</span>
                <span class="material-symbols-outlined" aria-hidden="true">arrow_outward</span>
              </button>
              <p class="contact-privacy tc-text">您提供的資料僅用於回覆本次詢問。</p>
            </div>

            <div id="contact-status" class="contact-status tc-text" role="status" aria-live="polite"></div>
          </form>

          <div id="contact-success" class="contact-success" hidden tabindex="-1">
            <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
            <p class="contact-success-eyebrow en-text">MESSAGE SENT</p>
            <h2 class="tc-text">訊息已送出</h2>
            <p class="tc-text">謝謝您與我們聯絡。若需要補充資訊，我們會再與您確認。</p>
            <a href={`${basePath}/`} class="contact-home-link tc-text">返回首頁</a>
          </div>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>
