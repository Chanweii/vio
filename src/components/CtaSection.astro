---
import ArrowButton from './ArrowButton.astro';
// 共用 CTA 區塊 — 首頁與聯絡頁都會用到。
---

<section class="cta-section">
  <div class="cta-container">
    <div class="cta-content">
      <h2 class="cta-title tc-text">與我們討論您的防護需求</h2>
      <p class="cta-desc tc-text">從設備與場域條件出發，評估適合的隔震與振動控制配置。</p>
    </div>
    <div class="cta-action">
      <ArrowButton text="與工程專家對談" href="#" theme="white" />
    </div>
  </div>
</section>
