---
// 共用 Footer — 依頁面語言選擇品牌標誌。
export interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = lang === 'en' ? `${basePath}/en/` : `${basePath}/`;
const logoLanguage = lang === 'en' ? 'e' : 'c';
const lightLogo = `${basePath}/picture/index/logo_light_${logoLanguage}.svg`;
const darkLogo = `${basePath}/picture/index/logo_dark_${logoLanguage}.svg`;
---

<footer class="footer">
  <div class="eng-container">
    <div class="footer-top">
      <!-- Column 1: Brand & Address -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <a href={homeHref}>
            <img src={lightLogo} class="logo-img logo-dark" alt="VIO" style="height: 32px;" />
            <img src={darkLogo} class="logo-img logo-light" alt="VIO" style="height: 32px;" />
          </a>
        </div>
        <p class="company-name tc-text">
          唯創光電精密科技股份有限公司<br /><span class="en-text">VIO Creation Technology Inc.</span>
        </p>
        <p class="address tc-text">
          新北市新店區安民街三巷11號{' '}
          <a href="https://maps.app.goo.gl/" target="_blank" class="map-link" title="Google 地圖">
            <span class="material-symbols-outlined">location_on</span>
          </a>
        </p>
      </div>

      <!-- Column 2: Links & Contact -->
      <div class="footer-col links-col">
        <div class="link-group">
          <h4 class="group-title">[ Pages ]</h4>
          <ul class="footer-nav tc-text">
            <li><a href="#">關於唯創</a></li>
            <li><a href="#">解決方案</a></li>
            <li><a href="#">產品與技術</a></li>
            <li><a href="#">工程能力</a></li>
          </ul>
        </div>
        <div class="link-group">
          <h4 class="group-title">[ Contact ]</h4>
          <ul class="contact-list en-text">
            <li><a href="mailto:viotech.inc@gmail.com" class="interactive-link">viotech.inc@gmail.com</a></li>
            <li>TEL: <a href="tel:+886286662511" class="interactive-link">(02) 8666-2511</a></li>
            <li>FAX: (02) 8666-2513</li>
          </ul>
        </div>
      </div>
    </div>

  </div>

    <!-- Bottom Row: Legal -->
    <div class="footer-bottom">
      <p class="copyright en-text">© 2024 VIO Creation Technology Inc.</p>
      <div class="legal-links">
        <a href="#" class="en-text">Privacy Policy</a>
        <a href="#" class="tc-text">版權與隱私條款</a>
      </div>
    </div>
</footer>
