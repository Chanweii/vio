---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';

export interface Props {
  title: string;
  lang?: 'zh-Hant' | 'en';
  headerLang?: 'zh' | 'en';
  dataTheme?: 'light' | 'dark';
}

const { title, lang = 'zh-Hant', headerLang = 'zh', dataTheme = 'light' } = Astro.props;

// 合併三個頁面原本各自宣告的 Material Symbols icon 子集,
// 補上聯絡頁表單其實有用到、但原本 head 沒宣告的 upload_file / check_circle / send。
const iconNames =
  'arrow_back,arrow_back_ios,arrow_forward,arrow_forward_ios,arrow_outward,chat_bubble,check,check_circle,circle,contrast,location_on,menu,send,upload_file';
const fontHref = lang === 'en'
  ? 'https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Inter:wght@400;500;600;700&family=Rubik:wght@400;500;600;700&text=0123456789%2B%25%2C.&display=swap';
---

<!DOCTYPE html>
<html lang={lang} data-theme={dataTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Google Fonts: Inter, Noto Sans TC & Rubik (Numbers Only) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={fontHref}
      media="print"
      onload="this.media='all'"
    />

    <!-- Material Symbols -->
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=${iconNames}`}
    />

    <ClientRouter />
    <slot name="head" />
  </head>

  <body>
    <Header lang={headerLang} />
    <slot />
    <script src="/js/main.js" is:inline></script>
    <slot name="scripts" />
  </body>
</html>
