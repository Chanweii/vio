# Optional production site URL.
# SITE_URL=https://your-domain.example

# Public browser key for the seismic evidence map.
# Restrict this key to the production and preview domains in MapTiler Cloud.
# PUBLIC_MAPTILER_KEY=your_maptiler_key

# Contact form receiver. It must accept a multipart POST request and return
# an HTTP 2xx response only after the message has been accepted for delivery.
# PUBLIC_CONTACT_FORM_ENDPOINT=https://your-form-endpoint.example/contact
